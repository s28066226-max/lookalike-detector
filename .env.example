# Copy this file to .env and fill in your values. Never commit .env.

# Which backend runs Gemma 4: "gemini" (Gemini API, default) or "ollama" (local open weights)
VISION_BACKEND=gemini

# Gemini API (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemma 4 model id. List the ones your key can use: python -m detector --list-models
GEMINI_MODEL=gemma-4-26b-a4b-it

# Ollama (optional, local). Check the exact tag with: ollama list
OLLAMA_MODEL=gemma4
